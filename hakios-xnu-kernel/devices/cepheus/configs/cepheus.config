# HakiOS fragment: the Xiaomi Mi 9 (cepheus) -- what is true of this device and of no other.
# Every phone driver is left out until it has been made to work here; the arguments only those drivers read go too.
CONFIG_DEVICE="cepheus"
CONFIG_HAKIOS_ADSP=y
CONFIG_HAKIOS_CS35L41=y
# CONFIG_HAKIOS_SPEAKER is not set
CONFIG_HAKIOS_SOUND=y
CONFIG_HAKIOS_SLIM=y
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_SOCINFO is not set
# the Adreno 640: only the steps made for SM8150 so far (adreno=N; drivers/gpu/hakios.adreno.c, board "cepheus")
CONFIG_HAKIOS_ADRENO=y
# the screen's brightness: the EA8076 panel's DCS brightness through DSI 0, and AppleARMBacklight for iOS's slider (backlight=2)
CONFIG_HAKIOS_BACKLIGHT=y
# CONFIG_HAKIOS_HAPTIC is not set
CONFIG_HAKIOS_PMHAPTIC=y
# CONFIG_HAKIOS_GOODIX is not set
# the touch screen: ST FingerTip on I2C (GPIO55/56), touchscreen=1
CONFIG_HAKIOS_STFTS=y
# power, volume and the AI key (as Home): the PM8150 through the SPMI arbiter, read only; GPIO97 (buttons=1)
CONFIG_HAKIOS_BUTTONS=y
# the modem (MPSS), for the Wi-Fi firmware it runs in its WLAN PD: Wi-Fi stage 1, modem_step=N; it stays offline (modem_online
# defaults to 0 here), its file systems are read from the flash and served from memory, nothing is written to them
CONFIG_HAKIOS_QMI=y
CONFIG_HAKIOS_MODEM=y
# the battery: the PM8150B's fuel gauge through the SPMI arbiter, read only (fuelgauge=2); BATTERY is the power source iOS reads
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_PMFG=y
# the cores' clocks: the SM8150's OSM (cpufreq=1; hakios.cpufreq.c, cepheus_raise) -- the boot loader leaves the big
# cores at 710/825 MHz; and the temperature sensors, read only, the run stopped at 105 C (thermal=1)
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_HAKIOS_THERMAL=y
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# the UFS flash through the loader on core 0 (ufs=2): read only, root from the darwin partition
CONFIG_HAKIOS_UFS=y
# CONFIG_HAKIOS_WIFI is not set
# the Wi-Fi of this phone, a WCN3998 in the modem's WLAN PD: the steps (wcn_step=N), and Linux's ath10k on WLAN (wcn_lx=1)
CONFIG_HAKIOS_WCN3990=y
CONFIG_HAKIOS_WLAN=y
CONFIG_TOUCHSCREEN=y
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_FIRMWARE is "device" in the common kernel: say "none" here until this device's firmware is pulled
# the keys (buttons=1)
CONFIG_BUTTONS=y
