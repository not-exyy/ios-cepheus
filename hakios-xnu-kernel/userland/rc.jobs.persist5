# Commands run by the launchd job com.hakios.demo (see com.hakios.demo.plist).
# What persistence buys, boot after boot (var_store=1 ufs_write=1; see rc.jobs.persist0 and
# rc.jobs.persist1, which are this list with a little before it). Everything here is a measurement,
# nothing here saves: the job com.hakios.varstore writes the volume when the kernel says the run is
# ending. Boot it five times over and compare the boots:
#   the store at the start, and how much room the volume has;
#   the line every run before this one left, and the keychain item an earlier boot wrote ("keep"
#   writes one only if there is none, so every later boot reads the first boot's);
#   the containers Darwin gives its applications -- the same identifiers boot after boot, or new ones;
#   the home screen's layout by hash and by the second it was written;
#   and, after two minutes of Darwin left to itself, the same again, with the process list.
/hakios/bin/var_store show
/hakios/bin/vol_ls fs /private/var
/hakios/bin/vol_ls cat /private/var/hakios-stamp 4096
/hakios/bin/keychain_test keep
/hakios/bin/vol_ls ls /private/var/mobile/Library/SpringBoard
/hakios/bin/vol_ls hash /private/var/mobile/Library/SpringBoard/IconState.plist
/hakios/bin/vol_ls ls /private/var/mobile/Containers/Data/Application
/hakios/bin/vol_ls ls /private/var/mobile/Containers/Shared/AppGroup
/hakios/bin/var_store stamp /private/var/hakios-stamp
sleep 120
/bin/ps -A
/hakios/bin/vol_ls ls /private/var/mobile/Library/SpringBoard
/hakios/bin/vol_ls hash /private/var/mobile/Library/SpringBoard/IconState.plist
/hakios/bin/keychain_test read
