# Commands run by the launchd job com.hakios.demo (see com.hakios.demo.plist).
# Text in scripts other than Latin: font_test says which font the system font falls back to for emoji, Chinese,
# Japanese and Korean and how many pixels drawing them paints (and in colour); then, with wifi=1, Safari opens the
# Chinese Wikipedia and a page of emoji as text, for screenshots.
/hakios/bin/sound_test springboard
/hakios/bin/rwtouch wait 10
/hakios/bin/font_test
/hakios/bin/battery_test open https://zh.m.wikipedia.org/
/hakios/bin/rwtouch wait 25
/hakios/bin/battery_test open https://getemoji.com/
/hakios/bin/rwtouch wait 25
